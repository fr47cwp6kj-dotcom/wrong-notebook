FROM cuoyin-agent-beta:2026-11-16-2

COPY --chown=nextjs:nodejs standalone/ ./
COPY --chown=nextjs:nodejs static/ ./.next/static
COPY --chown=nextjs:nodejs public/ ./public
COPY --chown=nextjs:nodejs prisma/ ./prisma
COPY --chown=nextjs:nodejs prisma-client/ ./node_modules/.prisma
COPY --chown=nextjs:nodejs dist-scripts/ ./dist-scripts
COPY --chown=nextjs:nodejs config/ ./config
COPY --chown=nextjs:nodejs docker-entrypoint.sh ./docker-entrypoint.sh
COPY --chown=nextjs:nodejs https-server.js ./https-server.js
